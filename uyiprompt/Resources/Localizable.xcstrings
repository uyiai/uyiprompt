    "desktop.autoRun": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start rewriting immediately"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「改写」后立刻开始"
          }
        }
      }
    },
    "desktop.autoRun.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the overlay opens first so you can pick a style."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉后，会先弹出窗口让你选风格再改写。"
          }
        }
      }
    },
    "desktop.dock": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Dock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在程序坞显示图标"
          }
        }
      }
