    "history.record.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, originals and results are no longer written to the local history file."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关掉后不再把原文和结果写入本机的历史文件。"
