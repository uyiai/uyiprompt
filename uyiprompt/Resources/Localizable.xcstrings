    "enhance.output": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewrite output"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改写输出"
          }
        }
      }
    },
    "enhance.output.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto keeps the original language."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动会保持原文语言。"
          }
        }
      }
    },
    "error.access": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility doesn’t match this build. In System Settings → Privacy & Security → Accessibility, remove the old uyiprompt, then add this one from Applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能开关对不上当前这份程序。请到系统设置 → 隐私与安全性 → 辅助功能：删掉旧的 uyiprompt，再把「应用程序」里的 uyiprompt 拖进去打开。"
          }
        }
      }
    },
    "error.dns": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server not found. Check the base URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到服务器，请检查接口地址是否正确"
          }
        }
      }
    },
    "error.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select some text, then tap Rewrite or Translate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先选中一段文字，再点弹出的「改写」或「翻译」"
          }
        }
      }
    },
    "error.emptyResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model returned nothing. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型没有返回内容，请再试一次"
          }
        }
      }
    },
    "error.http": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server error (%d)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回错误（%d）"
          }
        }
      }
    },
    "error.http401": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid key or no permission. Check the API key in Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥无效或没权限，请到设置里核对 API Key"
          }
        }
      }
    },
    "error.http404": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Base URL or model name may be wrong"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接口地址或模型名可能不对，请检查 Base URL 和模型"
          }
        }
      }
    },
    "error.http429": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many requests or quota used up. Try again later"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求太频繁或额度用完了，稍后再试"
          }
        }
      }
    },
    "error.httpBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server error (%d): %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务返回错误（%d）：%@"
          }
        }
      }
    },
    "error.missingKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No API key yet. Open Settings, pick DeepSeek, and paste your key."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有填 API Key。打开设置，选 DeepSeek 后贴上密钥即可。"
          }
        }
      }
    },
    "error.missingModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No model name yet. DeepSeek often uses deepseek-v4-flash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有填模型名。DeepSeek 常用 deepseek-v4-flash"
          }
        }
      }
    },
    "error.missingURL": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No base URL yet. For DeepSeek that’s usually https://api.deepseek.com/v1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有填接口地址。DeepSeek 一般是 https://api.deepseek.com/v1"
          }
        }
      }
    },
    "error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No network. Check the connection and try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网络不通，请检查网络后重试"
          }
        }
      }
    },
    "error.noSelection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t read the selection. Select it again, or open the panel and paste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没读到选中的文字。再选一次，或打开面板把文字贴进去。"
          }
        }
      }
    },
    "error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You appear to be offline. Check the connection and try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前没有网络连接，请检查网络后重试"
          }
        }
      }
    },
    "error.pasteAccess": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t paste back: Accessibility doesn’t match. Copy instead."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还写不回去：辅助功能对不上当前程序。可以先点「复制」。"
          }
        }
      }
    },
    "error.pasteFail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t paste back"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能粘贴回去"
          }
        }
      }
    },
    "error.selectOther": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select text in another app first, or open the panel and paste."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在别的软件里选中文字，或打开面板贴进去。"
          }
        }
      }
    },
    "error.switchApp": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch back to the original app and try again"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请切回原来的软件再试一次"
          }
        }
      }
    },
    "error.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request timed out. Try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求超时了，网络或服务较慢，请重试"
          }
        }
      }
    },
    "error.tls": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure connection failed. Check the base URL or your network"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建立安全连接失败，请检查接口地址或网络环境"
          }
        }
      }
    },
    "error.tooLong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That’s too long — 50,000 characters max"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文字太长了，最多 5 万字"
          }
        }
      }
    },
    "error.truncated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result may be truncated: the model hit its output limit"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果可能被截断了：文字较长，模型输出达到了上限"
          }
        }
      }
    },
    "hint.action": {
      "extractionState": "manual",
      "localizations": {
