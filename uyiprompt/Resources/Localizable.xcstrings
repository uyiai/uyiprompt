{
  "sourceLanguage": "en",
  "strings": {
    "access.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read selected text and paste the result back."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取选中的文字，并把改写或译文写回去。"
          }
        }
      }
    },
